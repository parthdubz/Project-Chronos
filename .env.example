# Copy this file to .env (it is git-ignored) and fill in real values.
# No value below is a working credential.

# Admin dashboard / leaderboard password. REQUIRED for the admin area:
# when it is empty the admin API stays switched off.
CHRONOS_ADMIN_PASSWORD=

# Optional: secret used to sign admin tokens (defaults to a key derived from the password).
CHRONOS_ADMIN_SECRET=

# Round 2 AI analyst. All optional: without any key the game uses its built-in replies.
# Tried in this order: every Groq key (with a cascade of models), then every Gemini key.
# Several keys = more requests per minute; a rate-limited or rejected key is skipped for a
# while and the next one is used. Never commit real keys: .env is git-ignored.
GROQ_API_KEYS=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# CHRONOS_AI_DISABLED=1   # never call any provider (offline rehearsal)

# Optional tuning
ROUND2_DURATION_SECONDS=1200
CORS_ORIGINS=*
# CHRONOS_DB_PATH=/absolute/path/to/chronos.db

# Transition Round passwords live in the Google Sheet "Project Chronos - Password List".
# The backend reaches it through the Apps Script web app in
# backend/tools/google_sheet_password_service.gs (see the setup steps at the top of that file).
TRANSITION_SHEET_URL=
TRANSITION_SHEET_SECRET=

# Tester shortcut: Ctrl+Shift+Alt+K skips the current stage with 0 points.
# Leave this OFF (unset / 0) for the real event.
# CHRONOS_ENABLE_SKIP=1

# Secure mode (default ON): players are put in fullscreen with Alt+Tab, Esc, Ctrl+W, F12, the
# Windows key etc. blocked, and leaving the window is logged for the host (admin > Team Logs).
# Set to 0 only for testing or on a machine where fullscreen is not wanted.
# CHRONOS_SECURE_MODE=1
